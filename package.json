{
  "name": "closeish-backend",
  "version": "17.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "validate": "node src/validate.mjs",
    "migrate": "node src/migrate.mjs",
    "dev": "node --env-file-if-exists=.env src/server.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --test tests/api.test.mjs tests/statistics.test.mjs tests/progress.test.mjs",
    "test:postgres": "node --test tests/postgres.test.mjs",
    "test:load": "node tests/load.mjs",
    "export:questions": "node scripts/export-content.mjs",
    "latency": "node scripts/latency-check.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
