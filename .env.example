# Example only. Copy values into Railway Variables. No automatic dotenv loading.
NODE_ENV=production
HOST=0.0.0.0
GAME_TIMEZONE=Europe/Budapest
# Railway reference variable: ${{Postgres.DATABASE_URL}} (use the real DB service name)
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_HOST:5432/railway
# Generate TWO different random secrets of at least 32 characters. Keep across deploys/replicas.
SIGNING_SECRET=REPLACE_WITH_A_RANDOM_SECRET
PLAYER_HASH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN
TRUST_PROXY=railway
PG_POOL_MAX=10
RATE_LIMIT_PER_MINUTE=600
WRITE_RATE_LIMIT_PER_MINUTE=120
# Optional. Comma-separated, each >=24 chars. When set, every /api/ request needs X-API-Key.
# API_KEYS=
# Leave PORT unset: Railway injects it. No DEV_DATE and no STATS_MODE=memory in production.
# PG_SSL_MODE=verify-full (only if the DB endpoint supports verified TLS; PG_SSL_CA optional)
# Public anonymous suggestions: per-IP throttle per API instance.
SUGGEST_LIMIT_PER_HOUR=4
